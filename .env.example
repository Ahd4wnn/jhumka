# ─── Jhumka server configuration ───────────────────────────────────────────────
# Copy to .env for local development. On the VPS these live in /etc/jhumka.env.
# Never commit real values.

# Public URL of the shop (no trailing slash). Used for canonical links, sitemap, alerts.
PUBLIC_SITE_URL=http://localhost:4321

# PostgreSQL — created by scripts/db/create.sql (use the password you chose there).
DATABASE_URL=postgres://jhumka:YOUR_PASSWORD@localhost:5432/jhumka
# Separate database for automated tests (created by the same script).
TEST_DATABASE_URL=postgres://jhumka:YOUR_PASSWORD@localhost:5432/jhumka_test

# Razorpay → Dashboard → Account & Settings → API keys (use TEST keys until launch).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → the secret you set when adding https://<domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Where processed product photos are stored (default: ./media).
# MEDIA_DIR=D:\f13s\jhumka\media

# Instagram handle shown in the footer and header (without @).
PUBLIC_INSTAGRAM_HANDLE=jhumka.in_
