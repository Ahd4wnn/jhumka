# /etc/systemd/system/jhumka.service
[Unit]
Description=Jhumka shop (Astro + Node)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=jhumka
Group=jhumka
WorkingDirectory=/opt/jhumka
EnvironmentFile=/etc/jhumka.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4321
ExecStart=/usr/bin/node dist/server/entry.mjs
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jhumka

[Install]
WantedBy=multi-user.target
