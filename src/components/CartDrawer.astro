---
---

<dialog id="bag" class="bag-dialog" data-lenis-prevent aria-labelledby="bag-title" transition:persist="bag">
  <div class="flex h-full flex-col">
    <div class="flex h-[var(--header-h)] items-center justify-between border-b border-purple-100 px-4 sm:px-6">
      <h2 id="bag-title" class="text-lg font-medium">Your bag</h2>
      <button type="button" class="grid size-10 place-items-center rounded-[999px] hover:bg-purple-50" aria-label="Close bag" data-close-dialog>
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
    </div>

    <div class="flex flex-1 flex-col items-center justify-center gap-5 px-8 text-center" data-bag-empty>
      <p class="display text-4xl leading-tight">Your bag is empty</p>
      <p class="max-w-xs text-sm">Add the pieces you love and they will wait for you here.</p>
      <a href="/shop" class="btn" data-close-dialog>Shop the collection</a>
    </div>

    <ul class="flex-1 overflow-y-auto px-4 sm:px-6" data-bag-items hidden></ul>

    <div class="border-t border-purple-100 px-4 pt-4 pb-[max(1rem,env(safe-area-inset-bottom))] sm:px-6" data-bag-footer hidden>
      <div class="flex items-baseline justify-between">
        <span class="text-sm">Subtotal</span>
        <span class="text-xl font-medium tabular-nums" data-bag-total>₹0</span>
      </div>
      <p class="mt-1 text-xs opacity-80">Shipping and discount codes are applied at checkout.</p>
      <a class="btn btn--lg mt-4 w-full" href="/checkout" data-close-dialog>Checkout</a>
      <button type="button" class="mt-3 w-full text-center text-sm underline-offset-4 hover:underline" data-close-dialog>Continue shopping</button>
    </div>
  </div>
</dialog>

<style>
  .bag-dialog {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(28rem, 100vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #fff;
    color: var(--color-purple);
  }
  .bag-dialog::backdrop {
    background: color-mix(in oklab, #7d46ab 45%, transparent);
  }
  .bag-dialog[open] {
    animation: bag-in 0.4s var(--ease-silk);
    box-shadow: var(--shadow-float);
  }
  @keyframes bag-in {
    from { transform: translateX(100%); }
  }
</style>
